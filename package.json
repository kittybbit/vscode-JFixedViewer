{
  "publisher": "kittybbit",
  "name": "vscode-JFixedViewer",
  "displayName": "vscode-J Fixed Viewer",
  "description": "日本で利用される、固定長のファイルを見やすく表示する拡張機能です。",
  "version": "1.3.1",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/kittybbit/vscode-JFixedViewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/kittybbit/vscode-JFixedViewer"
  },
  "bugs": {
    "url": "https://github.com/kittybbit/vscode-JFixedViewer/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "keywords": [
    "全銀協規定形式(FBデータ)"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "browser": "./dist/web.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-JFixedViewer.FiletypePicker",
        "title": "固定長のファイル形式を選択",
        "category": "JFixedViewer",
        "icon": "$(file-binary)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "clean": "rimraf out dist",
    "precompile": "npm-run-all qlty",
    "compile": "webpack",
    "watch": "webpack --watch",
    "prepackage": "npm-run-all clean qlty",
    "package": "webpack --mode production --devtool false",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run test:prepare",
    "qlty": "npm-run-all qlty:fmt qlty:check",
    "qlty:fmt": "qlty fmt",
    "qlty:check": "qlty check",
    "test": "vscode-test",
    "test:prepare": "npm-run-all compile-tests prepare:smoke compile:smoke",
    "prepare:smoke": "node scripts/prepare-smoke.mjs",
    "compile:smoke": "webpack --env smoke",
    "test:desktop": "vscode-test",
    "test:desktop:min": "node -e \"const path=require('node:path');require('@vscode/test-electron').runTests({version:'1.75.0',extensionDevelopmentPath:path.resolve('out/smoke-extension'),extensionTestsPath:path.resolve('out/test/smoke.js'),launchArgs:['--disable-telemetry']}).catch((error)=>{console.error(error);process.exitCode=1;})\"",
    "test:web": "vscode-test-web --browserType=chromium --quality=stable --extensionDevelopmentPath=out/smoke-extension --extensionTestsPath=out/smoke-extension/dist/smoke.js --esm",
    "test:architecture": "node --test out/test/architecture.test.js",
    "open-in-browser": "vscode-test-web --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.2",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vscode/extension-telemetry": "^0.9.9"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": "^12.0.3"
    },
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.5"
  }
}
